# 仓库内统一 LF，避免 Windows 上 core.autocrlf 造成的伪改动
* text=auto eol=lf

# 显式声明为文本（便于 diff）
*.h        text eol=lf
*.cpp      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.yml      text eol=lf
CMakeLists.txt text eol=lf

# 二进制产物
*.exe      binary
*.pdb      binary
*.ilk      binary
*.lib      binary
*.gif      binary
